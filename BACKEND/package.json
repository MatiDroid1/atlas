{
  "name": "atlas",
  "version": "1.0.0",
  "description": "API Atlas - Express + PostgreSQL (intencionalmente vulnerable)",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/app.js",
    "dev": "nodemon",
    "test": "jest --runInBand --forceExit --verbose",
    "test:report": "jest --runInBand --forceExit --verbose --json --outputFile=tests/results/report.json && node tests/generate-report.js"
  },
  "jest": {
    "testTimeout": 40000,
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "testEnvironment": "node"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.12.0",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "axios": "^1.20.0",
    "form-data": "^4.0.6",
    "jest": "^29.7.0",
    "nodemon": "^3.1.0"
  }
}
